						"url": {
							"raw": "{{base_url}}/auth/invite/validate",
							"host": ["{{base_url}}"],
							"path": ["auth", "invite", "validate"]
						},
						"description": "Validate Doctor invite token"
					},
					"response": []
				},
				{
					"name": "Complete Invite",
					"request": {
						"auth": {
							"type": "noauth"
