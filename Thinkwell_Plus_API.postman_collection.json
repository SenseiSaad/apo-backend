					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/activities/stats",
							"host": ["{{base_url}}"],
							"path": ["activities", "stats"]
						},
						"description": "Get activity statistics (streak, completion rate, avatar progress)"
					},
					"response": []
				}
			]
		},
		{
			"name": "Chat",
			"item": [
				{
					"name": "Send Message",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.data && response.data.session_id) {",
									"        pm.collectionVariables.set('session_id', response.data.session_id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
