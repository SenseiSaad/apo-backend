							"raw": "{{base_url}}/patient/profile",
							"host": ["{{base_url}}"],
							"path": ["patient", "profile"]
						},
						"description": "Get patient profile with tier, subscription, and Doctor info. Avatar state is intentionally excluded from this response."
					},
					"response": []
				},
				{
					"name": "Update Profile",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"full_name\": \"John Doe\",\n  \"date_of_birth\": \"1990-01-15\",\n  \"phone_number\": \"+1234567890\",\n  \"timezone\": \"America/Los_Angeles\",\n  \"preferences\": {\n    \"notifications_enabled\": true,\n    \"email_notifications\": true,\n    \"push_notifications\": true,\n    \"theme\": \"dark\"\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/patient/profile",
							"host": ["{{base_url}}"],
							"path": ["patient", "profile"]
						},
						"description": "Update patient profile fields. Send one or more fields. Avatar updates are handled separately and are intentionally excluded from this endpoint."
					},
					"response": []
				},
