					"name": "End Session",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/chat/sessions/{{session_id}}/end",
							"host": ["{{base_url}}"],
							"path": ["chat", "sessions", "{{session_id}}", "end"]
						},
						"description": "End a chat session"
					},
					"response": []
