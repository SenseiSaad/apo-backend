		},
		{
			"name": "Activities",
			"item": [
				{
					"name": "Get Activities",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/activities?start_date=2024-01-01&end_date=2024-12-31&activity_type=meditation&status=completed",
							"host": ["{{base_url}}"],
							"path": ["activities"],
							"query": [
								{
									"key": "start_date",
									"value": "2024-01-01",
									"description": "Optional"
								},
								{
									"key": "end_date",
									"value": "2024-12-31",
									"description": "Optional"
								},
								{
									"key": "activity_type",
									"value": "meditation",
									"description": "Optional: breathing, meditation, journaling, mood_checkin, reading, physical, custom"
								},
								{
									"key": "status",
									"value": "completed",
									"description": "Optional: pending, completed"
								}
							]
						},
						"description": "Get activity calendar with filters (Requires Basic or Premium tier)"
					},
					"response": []
				},
				{
					"name": "Get Activity Detail",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Set activity_id from collection variable or use a sample ID",
									"if (!pm.collectionVariables.get('activity_id')) {",
									"    pm.collectionVariables.set('activity_id', '507f1f77bcf86cd799439011');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/activities/{{activity_id}}",
							"host": ["{{base_url}}"],
							"path": ["activities", "{{activity_id}}"]
						},
						"description": "Get single activity details"
					},
					"response": []
				},
				{
					"name": "Complete Activity",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
