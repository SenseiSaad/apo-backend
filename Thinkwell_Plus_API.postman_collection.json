							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"patient@example.com\",\n  \"otp\": \"123456\",\n  \"password\": \"NewSecurePass123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/reset-password",
							"host": ["{{base_url}}"],
							"path": ["auth", "reset-password"]
						},
						"description": "Reset patient password with email OTP"
					},
					"response": []
				},
				{
					"name": "MFA Setup",
