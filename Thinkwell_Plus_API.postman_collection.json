						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"password\": \"SecurePass123!\",\n  \"code\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/mfa/disable",
							"host": ["{{base_url}}"],
							"path": ["auth", "mfa", "disable"]
						},
						"description": "Disable MFA"
					},
					"response": []
				},
				{
					"name": "Validate Invite",
					"request": {
						"auth": {
							"type": "noauth"
