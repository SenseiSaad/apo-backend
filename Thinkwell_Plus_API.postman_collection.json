							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"message\": \"I've been feeling anxious lately. Can you help me?\",\n  \"session_id\": \"{{session_id}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/chat/message",
							"host": ["{{base_url}}"],
							"path": ["chat", "message"]
						},
						"description": "Send message to AI (creates new session if session_id not provided)"
					},
					"response": []
				},
				{
					"name": "Get Chat History",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/chat/history?session_id={{session_id}}&limit=50",
							"host": ["{{base_url}}"],
							"path": ["chat", "history"],
							"query": [
								{
									"key": "session_id",
									"value": "{{session_id}}",
									"description": "Required"
								},
								{
									"key": "limit",
									"value": "50",
									"description": "Optional, default 50"
								}
							]
						},
						"description": "Get chat message history for a session"
					},
					"response": []
				},
				{
					"name": "Get Chat Sessions",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/chat/sessions?limit=20",
							"host": ["{{base_url}}"],
							"path": ["chat", "sessions"],
							"query": [
								{
									"key": "limit",
									"value": "20",
									"description": "Optional, default 20"
								}
							]
						},
						"description": "Get all chat sessions for user"
					},
					"response": []
				},
