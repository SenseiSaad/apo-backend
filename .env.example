# Copy this file to .env and fill values before deploying or running locally
NODE_ENV=production
PORT=5000
APP_URL=https://your-backend-domain.example
CLIENT_URL=https://your-frontend.example

# JWT
JWT_SECRET=changeme
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=changeme
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Database
MONGO_URI=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Other
ENCRYPTION_KEY=replace-with-32-char-key
# ================================
# THINKWELL PLUS - Environment Variables
# ================================

# Server
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# New Relic APM
# SERVER_ID is used as the New Relic app/service name.
# SERVER_TOKEN is used as the New Relic license/ingest key.
SERVER_ID=thinkwell-plus-backend
SERVER_TOKEN=your_new_relic_license_key
NEW_RELIC_ENABLED=false
NEW_RELIC_LOG_LEVEL=info
NEW_RELIC_LOG_FORWARDING=false

# Database (MongoDB)
DATABASE_URL=mongodb://localhost:27017/thinkwell_plus

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_minimum_32_chars_random_string_here
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Streamoji Avatar Creator
STREAMOJI_CLIENT_ID=your_streamoji_client_id
STREAMOJI_CLIENT_SECRET=your_streamoji_client_secret

# Cloudflare R2 storage for avatar GLBs and animation files
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET=thinkwell-avatars
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://pub-e6a89d9a285a4d64a3a67e687923f733.r2.dev
STREAMOJI_ANIMATIONS_R2_PREFIX=animations/streamoji
STREAMOJI_ANIMATIONS_SOURCE_DIR=C:\Users\geass\OneDrive\Desktop\Thinkwell\streamoji\streamoji\downloads\animations

# Hosted avatar viewer
AVATAR_VIEWER_BASE_URL=https://avatar-viewer.thinkwell.com
AVATAR_VIEWER_WS_BASE_URL=https://api.thinkwell.com
AVATAR_VIEWER_SESSION_SECRET=your_minimum_32_chars_avatar_viewer_secret
AVATAR_VIEWER_SESSION_TTL_SECONDS=900

# AWS (For production - use free alternatives in development)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=thinkwell-files
AWS_SES_FROM_EMAIL=noreply@thinkwellplus.com

# Stripe (Use test keys in development)
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# RevenueCat (Optional for iOS)
REVENUECAT_WEBHOOK_SECRET=your_revenuecat_secret

# AI Services (Free alternatives for development)
# Anthropic Claude - Use free tier or mock in development
ANTHROPIC_API_KEY=sk-ant-your_key_here

# OpenAI - For embeddings (free alternatives: sentence-transformers)
OPENAI_API_KEY=sk-your_openai_key_here

# Expo Push Notifications (Free)
EXPO_PUSH_TOKEN=your_expo_push_token

# Encryption (Generate: openssl rand -hex 32)
PHI_ENCRYPTION_KEY=your_32_byte_hex_key_for_aes256_encryption

# Sentry (Optional - for error tracking)
SENTRY_DSN=your_sentry_dsn_here

# Email Service (Development alternatives)
# Use Mailtrap, Ethereal, or console logging in development
EMAIL_SERVICE=console
MAILTRAP_USER=your_mailtrap_user
MAILTRAP_PASS=your_mailtrap_pass

# SMS Service (Development - use console logging)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890
